# Kopie als .env anlegen und ausfüllen. .env gehört NICHT ins Repository.

# ── LetterXpress (Postversand der Kampagnen) ──────────────
# API-Key im LXP-Kundenbereich erzeugen.
LXP_USER=
LXP_APIKEY=

# ── Bestandskunden von der Kampagne ausnehmen ─────────────
# Kommaliste der MaStR-Einheitennummern, dazu ein Regex-Alternativenausdruck
# für Firmennamen. Stehen hier und nicht im Code, weil das Repository
# öffentlich ist.
EXCLUDE_SEE=
EXCLUDE_FIRMA=

# ── Kurzlink-Tokens ───────────────────────────────────────
# Beliebige lange Zufallszeichenfolge. Bleibt sie konstant, erzeugt eine
# Neu-Extraktion dieselben Tokens; ein Nachdruck einzelner Briefe bleibt
# damit gültig. Ohne gesetzten Wert sind die Tokens reproduzierbar ratbar.
TOKEN_SALT=

# ── Layout-Diagnose (optional) ────────────────────────────
# DEBUG_LAYOUT=1 gibt beim Brief-Generator die Zwischenhöhen von Seite 1 aus.
# Nützlich, wenn ein Brief auf drei Seiten kippt.
DEBUG_LAYOUT=

# Die Briefschriften kommen aus fonts/print/ und werden einmalig mit
# `node scripts/build-print-fonts.js` aus den woff2-Dateien der Website
# erzeugt. Fehlt das Verzeichnis, fällt der Brief auf Helvetica zurück.
