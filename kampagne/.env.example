# Zugangsdaten und Einstellungen des Kampagnenversands.
# Steht in .gitignore — wird nicht committet. Das Repository ist oeffentlich.

# ── Absenderpostfach ──────────────────────────────────────────
# In hPanel anlegen: E-Mails → E-Mail-Konten → Konto erstellen.
# Das Passwort NUR hier eintragen, nirgends sonst.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=saison@kolibri-inspect.de
SMTP_PASS=hier-das-postfach-passwort

MAIL_FROM=saison@kolibri-inspect.de
MAIL_FROM_NAME=Kolibri Inspect

# Antworten sollen im gelesenen Postfach landen, nicht im Versandkonto.
MAIL_REPLY_TO=saison@kolibri-inspect.de
# Abmeldungen: eigene Adresse haelt das Hauptpostfach frei und macht die
# Sperrliste leichter pflegbar. Faellt auf MAIL_REPLY_TO zurueck.
ABMELDE_MAIL=saison@kolibri-inspect.de

# ── Ziele der Links ───────────────────────────────────────────
CAMPAIGN_BASE_URL=https://www.kolibri-inspect.de/angebot.html
MUSTERBERICHT_URL=https://www.kolibri-inspect.de/musterbericht.pdf
BILD_BASIS_URL=https://www.kolibri-inspect.de/Bilder/mail/
CAMPAIGN_REF=saison-mail-2026

# ── Empfaengerkreis ───────────────────────────────────────────
SAISON_PLZ=83,84,85
SAISON_MIN_KWP=100
SAISON_PROMO=SAISON-2026

# ── Takt ──────────────────────────────────────────────────────
# Zufaelliger Abstand zwischen zwei Nachrichten in Sekunden. Nicht unter
# 20 s setzen: ein enger, gleichfoermiger Takt ist das auffaelligste
# Merkmal eines Massenversands.
PAUSE_MIN_S=30
PAUSE_MAX_S=70

WEITERLEITUNG_AN=info@kolibri-inspect.de
