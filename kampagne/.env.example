# Hostinger SMTP fuer Kampagnen-Versand
# Kopiere diese Datei zu .env und fuelle die Werte aus.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kampagne@kolibri-inspect.de
SMTP_PASS=
MAIL_FROM=kampagne@kolibri-inspect.de
MAIL_FROM_NAME=Kolibri Inspect

# Reply-To: Empfaenger antworten auf eine eingelesene Adresse
MAIL_REPLY_TO=info@kolibri-inspect.de

# Basis-URL fuer den CTA-Link (Produktion)
CAMPAIGN_BASE_URL=https://kolibri-inspect.de/angebot.html

# Kampagnen-Tracking
CAMPAIGN_REF=kampagne-neuanlage-2026-04
PROMO_CODE=NEU2026

# Pfad zur Excel-Datei (relativ zum kampagne/-Ordner)
EXCEL_PATH=../Anschreiben/KolibriInspect_PV_Leads.xlsx
EXCEL_SHEET=Neuanlage

# Drosselung in Millisekunden zwischen Mails (Hostinger: 1000 ms reicht)
THROTTLE_MS=1000
